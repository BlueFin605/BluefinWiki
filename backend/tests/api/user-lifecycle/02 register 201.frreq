                "awsSig": {
                    "signUrl": false,
                    "accessKey": "",
                    "secretKey": "",
                    "sessionToken": "",
                    "awsRegion": "eu-central-1",
                    "serviceName": ""
                },
                "basicAuth": {
                    "userName": "",
                    "password": ""
                },
                "bearerToken": {
                    "token": ""
                }
            },
            "validation": {
                "type": "Body",
                "headers": [],
