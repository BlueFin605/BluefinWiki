                "httpCode": 201,
                "jsonSchema": {
                    "schema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"required\":[\"message\",\"userId\",\"email\",\"role\"],\"properties\":{\"message\":{\"const\":\"User registered successfully\"},\"userId\":{\"type\":\"string\",\"minLength\":8},\"email\":{\"type\":\"string\",\"pattern\":\"^api-suite-.+@example\\\\.com$\"},\"role\":{\"const\":\"Standard\"}}}"
                }
            }
        }
