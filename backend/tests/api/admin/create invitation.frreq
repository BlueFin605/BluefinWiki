                "body": "JsonSchema",
                "httpCode": 201,
                "jsonSchema": {
                    "schema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"required\":[\"inviteCode\",\"role\",\"expiresAt\",\"registrationLink\",\"emailSent\"],\"properties\":{\"inviteCode\":{\"type\":\"string\",\"pattern\":\"^[A-Z0-9]{8}$\"},\"role\":{\"const\":\"Standard\"},\"expiresAt\":{\"type\":\"string\"},\"registrationLink\":{\"type\":\"string\",\"pattern\":\"/register\\\\?invite=[A-Z0-9]{8}$\"},\"emailSent\":{\"const\":false}}}"
                }
