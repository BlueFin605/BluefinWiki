                    "schema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"required\":[\"guid\",\"title\",\"content\",\"folderId\",\"tags\",\"status\",\"createdBy\",\"modifiedBy\",\"createdAt\",\"modifiedAt\"],\"properties\":{\"guid\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$\"},\"title\":{\"const\":\"api-suite crud fixture\"},\"content\":{\"const\":\"updated by api suite\"},\"tags\":{\"const\":[\"api-suite\"]},\"status\":{\"const\":\"published\"},\"modifiedBy\":{\"const\":\"local-dev-user-id\"}}}"
