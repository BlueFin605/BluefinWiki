            "variables": [
                {
                    "variable": "payload",
                    "value": "{\"title\":\"api-suite create happy\",\"content\":\"body\",\"tags\":[\"api-suite\"],\"status\":\"published\"}",
                    "active": true,
                    "id": "3d3fca5a-f713-45a3-8ff3-8ca6031ce07f"
                }
            ],
            "secrets": [],
            "authentication": {
                "authentication": "inherit",
                "awsSig": {
                    "signUrl": false,
                    "accessKey": "",
                    "secretKey": "",
                    "sessionToken": "",
