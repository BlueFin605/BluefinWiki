                    "userName": "",
                    "password": ""
                },
                "bearerToken": {
                    "token": ""
                }
            },
            "validation": {
                "type": "Body",
                "headers": [],
                "body": "JsonSchema",
                "httpCode": 201,
                "jsonSchema": {
                    "schema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"required\":[\"guid\",\"title\",\"parentGuid\",\"createdAt\"],\"properties\":{\"guid\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$\"},\"title\":{\"const\":\"api-suite create happy\"},\"parentGuid\":{\"type\":\"null\"},\"createdAt\":{\"type\":\"string\",\"minLength\":20}}}"
                }
            },
            "capture": [
                {
                    "variable": "createdPageGuid",
                    "from": "body",
                    "path": "$.guid",
                    "id": "8579dedd-9ddc-45c2-91e6-19b781c5a19f"
                }
            ]
        },
