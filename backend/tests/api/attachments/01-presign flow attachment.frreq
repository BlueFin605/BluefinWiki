        "jsonSchema": {
            "schema": "{\"type\":\"object\",\"required\":[\"uploadUrl\",\"attachmentKey\",\"filename\"],\"properties\":{\"uploadUrl\":{\"type\":\"string\",\"pattern\":\"^https?://.*api-suite-flow\\\\.txt\\\\?\"},\"attachmentKey\":{\"type\":\"string\",\"pattern\":\"^{{crudPageGuid}}/_attachments/api-suite-flow\\\\.txt$\"},\"filename\":{\"const\":\"api-suite-flow.txt\"}}}"
