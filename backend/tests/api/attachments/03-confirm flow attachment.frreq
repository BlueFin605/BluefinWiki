        "jsonSchema": {
            "schema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"required\":[\"filename\",\"contentType\",\"size\",\"url\"],\"properties\":{\"filename\":{\"const\":\"api-suite-flow.txt\"},\"contentType\":{\"type\":\"string\"},\"size\":{\"const\":25},\"url\":{\"type\":\"string\",\"pattern\":\"/api-suite-flow\\\\.txt$\"}}}"
